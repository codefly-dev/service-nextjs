// Runs only in the isolated build stage, using the application's installed Next.
const fs = require('node:fs');
const path = require('node:path');
const { createRequire } = require('node:module');
const { spawnSync } = require('node:child_process');

async function build() {
  const app = fs.realpathSync(process.cwd());
  const source = fs.realpathSync(process.argv[2]);
  const runtime = path.resolve(process.argv[3]);
  const mode = process.argv[4];
  const inside = (root, target) => {
    const relative = path.relative(root, target);
    return relative === '' || (!relative.startsWith(`..${path.sep}`) && relative !== '..' && !path.isAbsolute(relative));
  };
  if (!inside(source, app) || inside(source, runtime) || inside(runtime, source)) throw Error('source/runtime overlap');
  const local = createRequire(path.join(app, 'package.json'));
  const loadConfig = local('next/dist/server/config').default;
  const { PHASE_PRODUCTION_BUILD } = local('next/constants');
  const config = await loadConfig(PHASE_PRODUCTION_BUILD, app);
  if (config.output !== mode) throw Error(`hosted Next output must be ${mode}, got ${config.output}`);
  const dist = path.resolve(app, config.distDir);
  if (path.isAbsolute(config.distDir) || dist === app || !inside(app, dist)) throw Error('distDir must be a child of the application');
  const tracing = fs.realpathSync(config.outputFileTracingRoot || app);
  if (!inside(source, tracing) || !inside(tracing, app)) throw Error('tracing root must contain the application within projected inputs');
  // Next exports to out by default, or to the configured non-default distDir.
  const exported = path.resolve(app, config.distDir === '.next' ? 'out' : config.distDir);
  const outputs = new Set(mode === 'export' ? [dist, exported] : [dist]);
  // Refuse every nonempty destination before removing even an empty directory.
  // A successful no-op build must never publish a pre-existing host export.
  for (const directory of outputs) {
    if (fs.existsSync(directory) && fs.readdirSync(directory).length) {
      throw Error(`${directory === dist ? 'distDir' : 'export destination'} overlaps staged input: ${directory}`);
    }
  }
  for (const directory of outputs) fs.rmSync(directory, { recursive: true, force: true });
  const result = spawnSync('npm', ['run', 'build'], { cwd: app, stdio: 'inherit', env: process.env });
  if (result.error) throw result.error;
  if (result.status !== 0) throw Error(`npm build failed: ${result.status}`);
  if (fs.existsSync(runtime)) throw Error('runtime destination already exists');
  if (mode === 'export') {
    fs.cpSync(exported, runtime, { recursive: true, dereference: true });
    return;
  }
  const metadata = JSON.parse(fs.readFileSync(path.join(dist, 'required-server-files.json'), 'utf8'));
  const relativeApp = path.relative(tracing, app);
  if (metadata.appDir !== app || metadata.relativeAppDir !== relativeApp ||
      metadata.config.output !== 'standalone' || metadata.config.distDir !== config.distDir ||
      path.resolve(metadata.config.outputFileTracingRoot || app) !== tracing) throw Error('fresh Next output metadata disagrees with production config');
  const standalone = path.join(dist, 'standalone');
  if (!fs.statSync(path.join(standalone, relativeApp, 'server.js')).isFile()) throw Error('standalone server missing');
  const target = path.join(runtime, path.relative(source, tracing));
  fs.cpSync(standalone, target, { recursive: true, dereference: true });
  const serverRoot = path.join(runtime, path.relative(source, app));
  for (const name of ['public', path.join(config.distDir, 'static')]) {
    const from = path.join(app, name);
    if (fs.existsSync(from)) fs.cpSync(from, path.join(serverRoot, name), { recursive: true, dereference: true });
  }
}
build().catch(error => { console.error(error); process.exitCode = 1; });

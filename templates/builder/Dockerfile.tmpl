FROM {{.NodeImage}} AS base

# Install dependencies
FROM base AS deps
# libc6-compat is a virtual name: apk resolves it to gcompat plus gcompat's own
# dependencies, so an `=<version>` pin would constrain one of the three packages
# actually installed and leave the rest floating. A base image digest pins the
# image, not the Alpine package index apk reads at build time, and that index
# carries only the current build of each package — so a version pin here does
# not go stale, it becomes unresolvable and fails the build outright.
# The resolved set is therefore RECORDED rather than pinned, and copied into
# both runtime images below: the OS packages an image was actually built from
# stay readable from the image whose digest the CLI captured.
RUN apk add --no-cache libc6-compat \
    && mkdir -p /codefly \
    && apk info -v | sort > /codefly/apk-packages.txt
WORKDIR /src

# Only declared package/archive roots are projected here, with their topology.
# Source precedes installs because npm lifecycle scripts can require it.
COPY src/ /src/
{{range .InstallWorkdirs}}
WORKDIR {{.}}
RUN npm ci
{{end}}

# Build with the complete set of clean installs, including linked packages.
FROM base AS builder
COPY --from=deps /src/ /src/
WORKDIR {{.AppWorkdir}}
COPY service.codefly.yaml /service.codefly.yaml
COPY next-build.cjs /codefly/next-build.cjs
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
{{range .BuildArgs}}
ARG {{.}}
ENV {{.}}=${{.}}
{{- end}}

RUN node /codefly/next-build.cjs /src /codefly/runtime {{if .Static}}export{{else}}standalone{{end}}

{{if .Static}}
# Static: serve with nginx.
# Pinned by digest so an unchanged recipe cannot resolve to different bytes on a
# later build. The tag is kept beside the digest so the served version stays
# readable and so the dependency-update automation bumps the two together. The
# digest is the multi-arch index that linux/amd64 and linux/arm64 both resolve
# through; a single-platform digest would not satisfy the recipe's platforms.
FROM nginx:1.31.8-alpine@sha256:1ef7ca94d7879df82421428ce13bd1eaa412404953859cf7a5b6512c25e67a60 AS runner

COPY --from=builder /codefly/runtime/ /usr/share/nginx/html
COPY --from=deps /codefly/apk-packages.txt /codefly/apk-packages.txt

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
{{else}}
# SSR: standalone Node.js server
FROM base AS runner
WORKDIR {{.RuntimeWorkdir}}

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

RUN rm -rf /usr/local/lib/node_modules/npm \
      /usr/local/lib/node_modules/corepack \
      /opt/yarn-v1.22.22 && \
    rm -f /usr/local/bin/npm /usr/local/bin/npx \
      /usr/local/bin/corepack /usr/local/bin/yarn /usr/local/bin/yarnpkg

RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 --ingroup nodejs nextjs

COPY --from=builder --chown=nextjs:nodejs /codefly/runtime/ /app/
COPY --from=deps /codefly/apk-packages.txt /codefly/apk-packages.txt

USER nextjs

EXPOSE 3000

ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

CMD ["node", "server.js"]
{{end}}
